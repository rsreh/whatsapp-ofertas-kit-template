# ------------------------------------------------------------------
# Evolution API (obrigatório para enviar)
# ------------------------------------------------------------------
# URL da SUA instância, sem barra no final.
EVOLUTION_API_URL="http://localhost:8080"
# Chave global da sua instância (a mesma do docker-compose).
EVOLUTION_API_KEY="troque-esta-chave"
# Nome da instância que você criou no manager da Evolution.
EVOLUTION_INSTANCE="ofertas"

# Destino: JID de grupo (120363...@g.us) ou telefone em E.164 (5511999999999).
WHATSAPP_TARGET="120363000000000000@g.us"

# ------------------------------------------------------------------
# Preview card (opcional, mas recomendado)
# ------------------------------------------------------------------
# URL pública deste servidor. Sem ela, o link enviado é o do produto.
# Para testar local: use um túnel (cloudflared/ngrok) e cole a URL aqui.
PUBLIC_BASE_URL=""
# Segredo para assinar os links de preview (mínimo 16 caracteres).
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
LINK_SECRET=""

# ------------------------------------------------------------------
# Agendamento
# ------------------------------------------------------------------
TIMEZONE="America/Sao_Paulo"
SEND_HOUR="9"
SEND_GAP_MS="4000"
# Protege GET /cron (header Authorization: Bearer ...).
CRON_SECRET=""
# Protege POST /send (header Authorization: Bearer ...).
ADMIN_TOKEN=""
PORT="3001"
# Onde fica o estado (trava anti-duplicidade).
STATE_FILE=".data/state.json"

# ------------------------------------------------------------------
# Fonte de produtos (escolha uma; a ordem de prioridade é Shopee > JSON > URLs)
# ------------------------------------------------------------------
# Lista manual:
PRODUCTS_FILE="products.json"
# URLs para extrair via Open Graph:
PRODUCT_URLS=""
# Shopee afiliados (requer aprovação no programa):
SHOPEE_APP_ID=""
SHOPEE_SECRET=""
SHOPEE_KEYWORDS=""
SHOPEE_MIN_DISCOUNT="10"
