{
  "name": "whatsapp-ofertas-node-cron",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Receita mínima: script Node + servidor HTTP para preview e cron.",
  "license": "MIT",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "preview": "tsx src/cli.ts preview",
    "send": "tsx src/cli.ts send",
    "once": "tsx src/cli.ts once",
    "typecheck": "tsc --noEmit",
    "sync-core": "node ../../scripts/sync-core.mjs ."
  },
  "dependencies": {
    "dotenv": "^16.4.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
