# ------------------------------------------------------------------
# Evolution API (obrigatório para enviar)
# ------------------------------------------------------------------
EVOLUTION_API_URL="http://localhost:8080"
EVOLUTION_API_KEY="troque-esta-chave"
EVOLUTION_INSTANCE="ofertas"

# JID de grupo (120363...@g.us) ou telefone E.164 (5511999999999).
WHATSAPP_TARGET="120363000000000000@g.us"

# ------------------------------------------------------------------
# Preview card (opcional, mas recomendado)
# ------------------------------------------------------------------
# URL pública deste site (ex.: https://ofertas.seudominio.com).
PUBLIC_BASE_URL=""
# Mínimo 16 caracteres. Gere com:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
LINK_SECRET=""

# ------------------------------------------------------------------
# Agendamento e proteção
# ------------------------------------------------------------------
TIMEZONE="America/Sao_Paulo"
SEND_HOUR="9"
SEND_GAP_MS="4000"
# GET /api/cron exige Authorization: Bearer $CRON_SECRET.
CRON_SECRET=""

# ------------------------------------------------------------------
# Fonte de produtos (Shopee > JSON > URLs)
# ------------------------------------------------------------------
PRODUCTS_FILE="products.json"
PRODUCT_URLS=""
SHOPEE_APP_ID=""
SHOPEE_SECRET=""
SHOPEE_KEYWORDS=""
SHOPEE_MIN_DISCOUNT="10"
